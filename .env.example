# MAISON 23 — environment variables. Copy to .env for local development (git-ignored).
# On Railway, set these under the service's Variables tab. Never commit real values.

# --- Required ---
# Postgres connection. On Railway: reference the Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://localhost/maison23_dev
# Host dashboard password (12+ characters). Use a long random passphrase.
ADMIN_PASSWORD=

# --- Links ---
# Base URL used in invitation links and emails (no trailing slash).
PUBLIC_BASE_URL=https://maison23.club

# --- Email (Resend) ---
# off  = nothing is sent (default, safe)
# test = every email goes ONLY to EMAIL_TEST_RECIPIENT, never to guests
# live = emails go to guests
EMAIL_MODE=off
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. MAISON 23 <invitations@maison23.club>
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_TEST_RECIPIENT=
# Webhook signing secret (whsec_…) for delivery tracking: endpoint https://<domain>/api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# --- Optional ---
PORT=3009
# RATE_LIMIT_INVITE_PER_MIN=60
# RATE_LIMIT_RSVP_PER_MIN=12
